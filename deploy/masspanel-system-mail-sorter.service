[Unit]
Description=Sort MassPanel system mailbox
After=network-online.target gromox-imap.service

[Service]
Type=oneshot
EnvironmentFile=/etc/masspanel/system-mail.env
ExecStart=/usr/local/libexec/masspanel-system-mail-sorter
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
